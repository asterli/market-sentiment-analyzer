          "rawSql": "SELECT\n  (SUM(CASE WHEN sentiment = 'positive' THEN 1 ELSE 0 END) - \n   SUM(CASE WHEN sentiment = 'negative' THEN 1 ELSE 0 END))::float / \n   COUNT(*)::float as sentiment_score\nFROM news_articles\nWHERE fetched_at >= NOW() - INTERVAL '24 hours'",
